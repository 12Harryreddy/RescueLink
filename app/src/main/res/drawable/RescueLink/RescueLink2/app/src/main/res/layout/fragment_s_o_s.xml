<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sosRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg3"
    android:padding="24dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Title -->

    <!-- CardView container with glowing and centered button -->

    <TextView
        android:id="@+id/sosTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="140dp"
        android:fontFamily="@font/sora_medium"
        android:gravity="center"
        android:text="@string/emergency_sos"
        android:textColor="@color/errorRed"
        android:textSize="27sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/sosCard"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="72dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sosTitle">

        <!-- Inner frame for glow and button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- Glow Effect View -->
            <View
                android:id="@+id/glowEffect"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_margin="8dp"
                android:alpha="0.3"
                android:background="@drawable/diamond_shape"
                android:layoutAnimation="@anim/pulse"
                android:scaleX="1"
                android:scaleY="1" />

            <!-- SOS Button -->
            <ImageButton
                android:id="@+id/btn_sos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/diamond_button_bg"
                android:contentDescription="@string/send_sos_alert"
                android:elevation="12dp"
                android:padding="32dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_sos_white"
                app:tint="@android:color/white" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
